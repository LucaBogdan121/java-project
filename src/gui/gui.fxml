<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <TabPane tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <tabs>
                <Tab text="Cars">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0">
                            <children>
                                <HBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                    <children>
                                        <TableView fx:id="carTableView" prefHeight="400.0" prefWidth="380.0">
                                            <columns>
                                                <TableColumn fx:id="carIdColumn" prefWidth="60.0" text="ID" />
                                                <TableColumn fx:id="carMakeColumn" prefWidth="100.0" text="Make" />
                                                <TableColumn fx:id="carModelColumn" prefWidth="100.0" text="Model" />
                                                <TableColumn fx:id="rentPriceColumn" prefWidth="90.0" text="Price" />
                                            </columns>
                                        </TableView>

                                        <GridPane hgap="10.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                            </rowConstraints>
                                            <children>
                                                <Label text="Car ID" />
                                                <TextField fx:id="carIdTextField" GridPane.columnIndex="1" />

                                                <Label text="Car Make" GridPane.rowIndex="1" />
                                                <TextField fx:id="carMakeTextFiled" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                <Label text="Car Model" GridPane.rowIndex="2" />
                                                <TextField fx:id="carModelTextField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                <Label text="Rent Price" GridPane.rowIndex="3" />
                                                <TextField fx:id="rentPriceTextFiled" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                                <Button onAction="#addCarButtonHandler" text="Add Car" GridPane.rowIndex="4" />
                                                <Button onAction="#deleteCarButtonHandler" text="Delete Car" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                                <Label text="Actions:" GridPane.rowIndex="5" />
                                                <ChoiceBox fx:id="carActionChoiceBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                                <Button fx:id="carExecuteButton" onAction="#executeCarActionHandler" text="Execute Action" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                            </children>
                                        </GridPane>
                                    </children>
                                </HBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab text="Reservations">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0">
                            <children>
                                <HBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                    <children>
                                        <TableView fx:id="reservationTableView" prefHeight="400.0" prefWidth="420.0">
                                            <columns>
                                                <TableColumn fx:id="reservationIdColumn" prefWidth="50.0" text="ID" />
                                                <TableColumn fx:id="reservationCarIdColumn" prefWidth="70.0" text="Car ID" />
                                                <TableColumn fx:id="reservationCustomerIdColumn" prefWidth="70.0" text="Customer ID" />
                                                <TableColumn fx:id="reservationStartDateColumn" prefWidth="100.0" text="Start Date" />
                                                <TableColumn fx:id="reservationEndDateColumn" prefWidth="100.0" text="End Date" />
                                            </columns>
                                        </TableView>

                                        <GridPane hgap="10.0" vgap="10.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                            </rowConstraints>
                                            <children>
                                                <Label text="Reservation ID" />
                                                <TextField fx:id="reservationIdTextField" GridPane.columnIndex="1" />

                                                <Label text="Car ID" GridPane.rowIndex="1" />
                                                <TextField fx:id="reservationCarIdTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                <Label text="Customer ID" GridPane.rowIndex="2" />
                                                <TextField fx:id="reservationCustomerIdTextField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                <Label text="Start Date" GridPane.rowIndex="3" />
                                                <TextField fx:id="reservationStartDateTextField" promptText="yyyy-MM-dd" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                                <Label text="End Date" GridPane.rowIndex="4" />
                                                <TextField fx:id="reservationEndDateTextField" promptText="yyyy-MM-dd" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                                <Button onAction="#addReservationButtonHandler" text="Add Reservation" GridPane.rowIndex="5" />
                                                <Button onAction="#deleteReservationButtonHandler" text="Delete Reservation" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                                <Label text="Actions:" GridPane.rowIndex="6" />
                                                <ChoiceBox fx:id="reservationActionChoiceBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                                <Button fx:id="reservationExecuteButton" onAction="#executeReservationActionHandler" text="Execute Action" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                                            </children>
                                        </GridPane>
                                    </children>
                                </HBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>